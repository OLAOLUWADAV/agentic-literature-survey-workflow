{
  # Global options
  email admin@{$DOMAIN_NAME:localhost}
}

{$DOMAIN_NAME:localhost} {
  # Reverse proxy all requests to n8n container
  reverse_proxy n8n:5678 {
    # WebSocket support (crucial for n8n execution canvas & live updates)
    header_up Host {host}
    header_up X-Real-IP {remote}
    header_up X-Forwarded-For {remote}
    header_up X-Forwarded-Proto {scheme}

    # Timeouts tuned for long-running AI synthesis agent workflows (10 minutes)
    transport http {
      response_header_timeout 600s
      read_timeout 600s
      write_timeout 600s
    }
  }

  # Security headers
  header {
    X-Frame-Options "SAMEORIGIN"
    X-XSS-Protection "1; mode=block"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  }

  # Compression
  encode zstd gzip

  # Access logging
  log {
    output stdout
    format console
  }
}
