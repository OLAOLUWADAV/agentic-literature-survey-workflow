# ==============================================================================
# Agentic Literature Survey Workflow - Production Environment Configuration
# ==============================================================================
# Copy this file to .env before starting production:
#   cp .env.example .env
# Fill in your domain name and API keys.

# ------------------------------------------------------------------------------
# 1. DOMAIN & WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to your production server (e.g. survey.example.com)
# For local testing, use "localhost"
DOMAIN_NAME=localhost

# Protocol: https (recommended for production) or http (local testing)
N8N_PROTOCOL=https

# The public URL where n8n webhooks and forms are accessible
# Example: https://survey.yourdomain.com
WEBHOOK_URL=http://localhost:5678

# Timezone for workflow executions and timestamps
GENERIC_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PRODUCTION DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production database credentials (change these to strong secure values!)
POSTGRES_USER=n8n_prod
POSTGRES_PASSWORD=super_secure_password_replace_in_production_123!
POSTGRES_DB=n8n_survey_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. N8N SECURITY & SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# Encryption key for n8n credentials storage (generate a 32+ char random string)
# Command to generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_32_character_hex_key_here

# Enable reading environment variables in workflow expressions ($env.VAR_NAME)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# File permissions check
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Binary data storage mode: filesystem recommended for large PDFs/documents
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ------------------------------------------------------------------------------
# 4. AI AGENT LLM API KEYS
# ------------------------------------------------------------------------------
# Groq API Key: Used by Research Manager Agent & Literature Matrix Builder
# Sign up at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key: Used by Paper Analyzer, Matrix Builder, Query Refiner
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Google Gemini API Key: Used by Citation Manager
# Sign up at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional fallback / alternative to OpenRouter)
# Sign up at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. STORAGE & DATABASE INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Airtable Personal Access Token & Base details (optional, workflow completes even if unset)
AIRTABLE_API_KEY=pat_your_airtable_token_here
AIRTABLE_BASE_ID=appYourBaseIdHere
AIRTABLE_TABLE_NAME=Literature_Reviews

# ------------------------------------------------------------------------------
# 6. STANDALONE RUNNER & API SERVER (OPTIONAL)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
