# =============================================================================
# Research Intelligence n8n — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# The system uses any OpenAI-compatible API. Choose one provider below.
# Default: OpenRouter (free models available, no local hardware required)

LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# --- ALTERNATIVE: Ollama (local inference, completely free, no API key needed)
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2:3b
# No API key required. All processing stays on your machine.
# LLM_API_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# --- ALTERNATIVE: Groq (fast free tier, requires free account at console.groq.com)
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant

# --- ALTERNATIVE: Gemini (requires Google AI Studio key at aistudio.google.com)
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1
# LLM_API_KEY=AIza_your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# --- ALTERNATIVE: OpenAI (requires paid account)
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# --- ALTERNATIVE: Anthropic Claude (via OpenRouter)
# LLM_API_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=anthropic/claude-3-haiku:beta

# -----------------------------------------------------------------------------
# Research Output
# -----------------------------------------------------------------------------
OUTPUT_DIR=/output
OUTPUT_FORMAT=html,json,markdown

# -----------------------------------------------------------------------------
# Scholarly Database Configuration
# -----------------------------------------------------------------------------

# CrossRef Polite Pool: provide your institutional email to get better rate limits
# See: https://www.crossref.org/documentation/retrieve-metadata/rest-api/tips-for-using-the-crossref-rest-api/
CROSSREF_MAILTO=your.email@institution.edu

# Semantic Scholar API key: free, improves rate limit from 100 req/5min to 1 req/sec
# Register at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# PubMed NCBI API key: free, improves rate limit from 3/sec to 10/sec
# Register at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Document Processor Service
# -----------------------------------------------------------------------------
# URL of the PDF extraction service (included in docker-compose.yml)
DOCUMENT_PROCESSOR_URL=http://document-processor:8080

# -----------------------------------------------------------------------------
# Optional: PostgreSQL (replace file-based storage with database)
# -----------------------------------------------------------------------------
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=research_intelligence
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=change_this_to_a_strong_password

# -----------------------------------------------------------------------------
# n8n Settings
# -----------------------------------------------------------------------------
# Change these before deploying. The encryption key must be at least 32 characters.
# Required: allows workflow nodes to read $env.* variables (LLM keys, API keys)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_to_a_strong_password

# Must be at least 32 characters. Used to encrypt stored credentials.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_this_to_a_32_char_minimum_key

# The public URL where n8n is accessible (used for webhook URLs)
WEBHOOK_URL=http://localhost:5678

# n8n data persistence directory (host path)
N8N_DATA_DIR=./n8n-data

# Output directory (host path, mapped to /output inside containers)
OUTPUT_DATA_DIR=./output

# -----------------------------------------------------------------------------
# Optional: Ollama GPU Configuration
# -----------------------------------------------------------------------------
# Uncomment to enable GPU acceleration for Ollama (requires NVIDIA GPU + drivers)
# OLLAMA_GPU_DRIVER=nvidia
# OLLAMA_GPU_COUNT=1
